{
  "manifest_version": 3,
  "name": "RecDock · ChatGPT",
  "version": "0.2.1",
  "description": "Send complete RecDock transcripts to one connected ChatGPT tab.",
  "permissions": [
    "storage",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*"
      ],
      "js": [
        "workspace-content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RecDock · ChatGPT"
  },
  "key": ""
}
