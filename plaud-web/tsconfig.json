{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": [
      "web-bluetooth",
      "node"
    ],
    "noUnusedLocals": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "server",
    "tests",
    "vite.config.ts"
  ]
}
