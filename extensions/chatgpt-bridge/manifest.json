{
  "manifest_version": 3,
  "name": "RecDock · ChatGPT 转发",
  "version": "0.1.0",
  "description": "将用户选定的 RecDock 转写稿发送到同一个 ChatGPT 标签页。",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["http://localhost/*"], "js": ["workspace-content.js"], "run_at": "document_start", "all_frames": false }],
  "action": { "default_popup": "popup.html", "default_title": "RecDock · ChatGPT 转发" }
}
